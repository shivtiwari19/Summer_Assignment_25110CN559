#include<stdio.h>

int main() {
    int a[10], n, i;

    printf("Enter no. of terms: ");
    scanf("%d", &n);

    printf("Enter the data: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("The resultant array: ");
    for(i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
#include <stdio.h>

int main() {
    int choice, score = 0;

    printf("===== Simple Quiz =====\n\n");

    printf("Q1. Capital of India?\n");
    printf("1. Mumbai\n2. Delhi\n3. Kolkata\n4. Chennai\n");
    printf("Enter Answer: ");
    scanf("%d", &choice);

    if(choice == 2)
        score++;

    printf("\nQ2. C Language was developed by?\n");
    printf("1. Dennis Ritchie\n2. James Gosling\n3. Bjarne Stroustrup\n4. Guido van Rossum\n");
    printf("Enter Answer: ");
    scanf("%d", &choice);

    if(choice == 1)
        score++;

    printf("\nQ3. 10 + 20 = ?\n");
    printf("1. 10\n2. 20\n3. 30\n4. 40\n");
    printf("Enter Answer: ");
    scanf("%d", &choice);

    if(choice == 3)
        score++;

    printf("\nYour Score = %d/3\n", score);

    if(score == 3)
        printf("Excellent!\n");
    else if(score == 2)
        printf("Good Job!\n");
    else
        printf("Keep Practicing!\n");

    return 0;
}
#include<stdio.h>

int main() {
    int n, d, sum, temp,x,y;
    printf("Enter range:");
    scanf("%d %d",x,y);


    for(n = x; n <= y; n++) {
        temp = n;
        sum = 0;

        int num = n;   

        while(num > 0) {
            d = num % 10;
            sum = sum + d * d * d;
            num = num / 10;
        }

        if(temp == sum) {
            printf("%d ", temp);
        }
    }

    return 0;
}
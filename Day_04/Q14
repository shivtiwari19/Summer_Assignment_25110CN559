#include<stdio.h>
int main() {
    int n, i;
    int f1= 0, f2 = 1, f3;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    if(n == 1) {
        printf("Nth term = %d", f1);
    }
    else if(n == 2) {
        printf("Nth term = %d", f2);
    }
    else {
        for(i = 3; i <= n; i++) {
            f3 = f1 + f2;
            f1 = f2;
            f2 = f3;
        }
        printf("Nth term = %d", f3);
    }

    return 0;
}
#include<stdio.h>

int main() {
    int n, temp, d, sum = 0, i, fact;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while(n > 0) {
        d = n % 10;

        fact = 1;
        for(i = 1; i <= d; i++) {
            fact = fact * i;
        }

        sum = sum + fact;
        n = n / 10;
    }

    if(sum == temp) {
        printf("%d is a Strong Number", temp);
    }
    else {
        printf("%d is Not a Strong Number", temp);
    }

    return 0;
}
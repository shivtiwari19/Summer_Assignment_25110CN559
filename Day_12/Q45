#include <stdio.h>

int palindrome(int n) {
    int rev = 0, temp = n, d;

    while(n > 0) {
        d = n % 10;
        rev = rev * 10 + d;
        n = n / 10;
    }

    return temp == rev;
}

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(palindrome(n))
        printf("Palindrome Number");
    else
        printf("Not a Palindrome Number");

    return 0;
}
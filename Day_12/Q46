#include <stdio.h>

int armstrong(int n) {
    int sum = 0, temp = n, d;

    while(n > 0) {
        d = n % 10;
        sum = sum + d*d*d;
        n = n / 10;
    }

    return temp == sum;
}

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(armstrong(n))
        printf("Armstrong Number");
    else
        printf("Not an Armstrong Number");

    return 0;
}
#include <stdio.h>
int main () {
    int i,n,prime,x,y;
    printf("Enter range to find prime no.");
    scanf("%d%d",&x,&y);
    for(n=x;n<=y;n++){
        prime = 1;
        for(i=2;i<=n/2;i++){
            if(n%i==0){
                prime = 0;
                break;
            }
        }
        if(prime==1){
            printf("%d ",n);
        }
    }
    return 0;
}
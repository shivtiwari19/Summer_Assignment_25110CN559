#include<stdio.h>
int main () {
    int n,i,prime=1;
    printf("Enter a no.:");
    scanf("%d",&n);

    for(i=2;i<=n/2;i++){
        if(n%i==0){
            prime=0;
            break;
        }
    }
    if(prime==1) {
       printf("Number is prime");

    }
    else {
        printf("Number is not prime");
    }
    return 0;
}
